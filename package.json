{
  "name": "concierge-qa",
  "version": "1.0.0",
  "description": "WebdriverIO + Appium test framework for a fictional luxury hotel guest app (web, mobile web and native Android).",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "app": "npm run app:build && npm run app:serve",
    "app:bugs": "cross-env BUG_MODE=on npm run app",
    "app:build": "vite build --config app/vite.config.ts",
    "app:serve": "tsx app/server/index.ts",
    "test:smoke": "wdio run tests/web/wdio.conf.ts --mochaOpts.grep @smoke",
    "test:regression": "wdio run tests/web/wdio.conf.ts --mochaOpts.grep @regression",
    "test:firefox": "cross-env BROWSER=firefox npm run test:regression",
    "test:mobile-web": "wdio run tests/web/wdio.mobile-web.conf.ts --mochaOpts.grep @smoke",
    "test:seeded-bugs": "tsx scripts/run-seeded-bugs.ts",
    "report:summary": "tsx scripts/summarize-results.ts",
    "typecheck": "tsc -p app && tsc -p tests && tsc -p scripts && tsc -p practice/bug-hunt/tools",
    "lint": "eslint .",
    "lint:locales": "tsx scripts/check-locales.ts",
    "bug-hunt": "tsx practice/bug-hunt/tools/run.ts",
    "bug-hunt:verify": "tsx practice/bug-hunt/tools/verify.ts",
    "bug-hunt:verify:wdio": "tsx practice/bug-hunt/tools/verify-wdio.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/webdriverio": "^4.13.0",
    "@eslint/js": "^10.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@wdio/allure-reporter": "^9.32.0",
    "@wdio/appium-service": "^9.32.0",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "allure": "^3.20.1",
    "appium": "^3.8.0",
    "appium-uiautomator2-driver": "^8.7.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "eslint-plugin-wdio": "^9.31.3",
    "globals": "^17.0.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1",
    "webdriverio": "^9.32.0"
  }
}
